# Copy this file to .env and set non-default secrets. NEVER commit .env.
MYSQL_DATABASE=uhiltaxi
MYSQL_USER=uhiltaxi
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_PORT=3306
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
# Cryptographically random secret; at least 32 UTF-8 bytes. Shared by API & Docker.
JWT_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_ISSUER=UhilTaxi.Api
JWT_AUDIENCE=UhilTaxi.Client
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14
# For dotnet run (Docker API uses Server=mysql internally):
ConnectionStrings__Default=Server=localhost;Port=3306;Database=uhiltaxi;User=uhiltaxi;Password=CHANGE_ME;AllowPublicKeyRetrieval=True;SslMode=None;

# Optional, local Development bootstrap admin. Enable for first start only, then set false.
ADMIN_SEED_ENABLED=false
ADMIN_SEED_PHONE=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_FIRST_NAME=
ADMIN_SEED_LAST_NAME=
ADMIN_SEED_EMAIL=
